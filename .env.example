# Copie este archivo como .env y ajuste lo que necesite.
# El entorno y systemd tienen prioridad sobre lo que se escriba aqui.
# No versione el .env: contiene credenciales.

# --- Servidor ---
PORT=3000
# Escuche solo en la red interna si el proxy corre en la misma maquina:
# HOST=127.0.0.1
HOST=0.0.0.0

# --- Seguridad (obligatorio al publicar) ---
# Active la cookie segura cuando sirva por HTTPS.
COOKIE_SECURE=0
# Ponga 1 si hay un proxy inverso (nginx, Caddy) delante.
TRUST_PROXY=0
# Dias que dura la sesion.
SESSION_DAYS=7
# Intentos de acceso fallidos permitidos por cada 10 minutos.
LOGIN_MAX_ATTEMPTS=8

# --- Administrador inicial (solo se usa en el primer arranque) ---
# Si se omiten, se genera una contrasena y se imprime una vez en la consola.
#ADMIN_NAME=Administrador
#ADMIN_EMAIL=admin@empresa.com
#ADMIN_PASSWORD=cambie-esta-clave

# --- Datos ---
# Rutas de la base y de las evidencias. Respalde esta carpeta.
DATA_DIR=./data
#DB_FILE=./data/bytewall.db
#UPLOAD_DIR=./data/uploads
#BACKUP_DIR=./backups

# --- Evidencias ---
# Tamano maximo por archivo en MB. Si lo sube, ajuste tambien el limite
# del proxy inverso (client_max_body_size en nginx).
MAX_UPLOAD_MB=25

# --- Registro ---
# 1 registra una linea por peticion, 0 lo desactiva.
LOG_REQUESTS=1
